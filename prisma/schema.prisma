generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum BillingStatus {
  UNPAID
  WAITING_VERIFICATION
  PAID
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String
  email      String   @unique
  password   String
  role       Role     @default(CUSTOMER)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @updatedAt @db.Timestamp(0)

  subscriptions     Subscription[]
  verified_payments Payment[]      @relation("PaymentVerifier")

  @@map("users")
}

model ServiceProvider {
  id              String   @id @default(uuid()) @db.VarChar(36)
  name            String
  description     String
  speed           Int
  price_per_month Decimal  @db.Decimal(14, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @updatedAt @db.Timestamp(0)

  subscriptions Subscription[]

  @@map("service_providers")
}

model Subscription {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  user_id             String             @db.VarChar(36)
  service_provider_id String             @db.VarChar(36)
  status              SubscriptionStatus @default(ACTIVE)
  registered_at       DateTime           @default(now()) @db.Timestamp(0)
  created_at          DateTime           @default(now()) @db.Timestamp(0)
  updated_at          DateTime           @updatedAt @db.Timestamp(0)

  user             User            @relation(fields: [user_id], references: [id], onDelete: Restrict)
  service_provider ServiceProvider @relation(fields: [service_provider_id], references: [id], onDelete: Restrict)
  billings         Billing[]

  @@map("subscriptions")
}

model Billing {
  id              String        @id @default(uuid()) @db.VarChar(36)
  subscription_id String        @db.VarChar(36)
  period_month    Int
  period_year     Int
  amount          Decimal       @db.Decimal(14, 2)
  due_date        DateTime      @db.Timestamp(0)
  status          BillingStatus @default(UNPAID)
  created_at      DateTime      @default(now()) @db.Timestamp(0)
  updated_at      DateTime      @updatedAt @db.Timestamp(0)

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  payment      Payment?

  @@unique([subscription_id, period_month, period_year])
  @@map("billings")
}

model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  billing_id    String        @unique @db.VarChar(36)
  payment_proof String
  status        PaymentStatus @default(PENDING)
  verified_by   String?       @db.VarChar(36)
  verified_at   DateTime?     @db.Timestamp(0)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @updatedAt @db.Timestamp(0)

  billing  Billing @relation(fields: [billing_id], references: [id], onDelete: Restrict)
  verifier User?   @relation("PaymentVerifier", fields: [verified_by], references: [id], onDelete: SetNull)

  @@map("payments")
}
